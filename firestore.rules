rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    function validBook() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'year', 'writer', 'publisher', 'genre', 'pages', 'createdAt'])
        && d.name is string && d.name.size() > 0
        && d.writer is string && d.writer.size() > 0
        && d.year is string && d.year.matches('^[0-9]{4}$')
        && d.pages is string && d.pages.matches('^[1-9][0-9]*$');
    }

    // Perfil do usuário: cada um lê só o seu e só pode se criar como "leitor".
    // O admin é criado manualmente no console do Firebase.
    match /usuarios/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'email', 'role'])
        && request.resource.data.role == 'leitor';
      allow update, delete: if false;
    }

    // Livros: qualquer usuário logado lê, só o admin escreve.
    match /livros/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && validBook();
      allow delete: if isAdmin();
    }
  }
}
